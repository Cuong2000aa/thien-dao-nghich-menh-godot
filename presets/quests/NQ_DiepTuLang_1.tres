[resource]
script = ExtResource("1_qd")
name = "Huyết Tích Dã Ngoại"
description = "Diệp Tử Lăng phát hiện vết máu kỳ quái dẫn sâu vào hẻm núi. Hắn cần một người gan dạ đi cùng kiểm tra thực hư."
giver = "Diệp Tử Lăng"
giverLocation = "Sơn Lâm Ngoại Vi"
target = "Truy vết huyết tích và tiêu diệt 3 Yêu Thú Cuồng Bạo"
targetLocation = "Sơn Lâm Ngoại Vi"
reward = "180 Tu Vi, 120 Linh Thạch, 50 Hảo Cảm Diệp Tử Lăng"
