[ext_resource type="Script" path="res://sources/db/instance/QuestData.gd" id="1_qd"]

[resource]
script = ExtResource("1_qd")
name = "Bí Mật Trong Cổ Tích"
description = "Thâm nhập Hiên Viên Cổ Động theo chỉ dẫn Mặc Lão Nhân. Cổ tịch mâu thuẫn lịch sử tông môn; trận văn lệch quỹ đạo — ký ức về quy tắc Trái Đất và Thiên Đạo bắt đầu khớp nhau."
giver = "Mặc Lão Nhân"
giverLocation = "Trúc Sơn Cổ Bi"
target = "Giải mã thiên địa trận văn bị trôi dạt tại cổ động"
targetLocation = "Hiên Viên Cổ Động"
reward = "400 Tu Vi, 350 Linh Thạch, 1 Bạch Ngân Kiếm, Mảnh Ký Ức IV"
