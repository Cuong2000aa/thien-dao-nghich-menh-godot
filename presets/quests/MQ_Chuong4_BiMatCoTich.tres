script = ExtResource("1_qd")
name = "Bí Mật Trong Cổ Tích"
description = "Thâm nhập Hiên Viên Cổ Động, phát hiện các cổ tịch bị niêm phong có niên đại trùng khớp với đại kiếp thượng cổ bị che giấu."
