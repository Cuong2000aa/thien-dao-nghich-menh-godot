script = ExtResource("1_qd")
name = "Bí Cảnh Thảo Dược"
description = "Phát hiện một biệt viện trồng dược liệu cổ xưa bị sương mù che phủ. Thu thập giống Huyết Sâm ngàn năm còn sót lại mang về cho Dược Đường."
