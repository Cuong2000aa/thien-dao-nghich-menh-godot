[resource]
script = ExtResource("1_qd")
name = "Cống Hiến Dược Thảo"
description = "Kho dược của Dược Đường cần bổ sung Ngân Linh Thảo tươi mới để luyện đan. Thu thập 3 cọng Ngân Linh Thảo giao nộp cho Dược Đường Chấp Sự."
giver = "Dược Đường Chấp Sự"
giverLocation = "Dược Đường"
target = "Thu thập & Giao nộp 3 Ngân Linh Thảo"
targetLocation = "Rặng Trúc Ngoại Vi"
reward = "45 Điểm Cống Hiến, 50 Tu Vi, 1 Hồi Xuân Đan"
