[resource]
script = ExtResource("1_qd")
name = "Tâm Ma Thử Thách"
description = "Sau khi đột phá, Trần Phương bị tạp niệm quấy nhiễu. Hắn muốn cùng đạo hữu luận kiếm luận đạo tại diễn võ đài để tẩy rửa tâm thức."
giver = "Trần Phương"
giverLocation = "Diễn Võ Trường"
target = "Tỉ thí giao lưu võ học cùng Trần Phương"
targetLocation = "Diễn Võ Trường"
reward = "200 Tu Vi, 100 Linh Thạch, 100 Hảo Cảm Trần Phương"
