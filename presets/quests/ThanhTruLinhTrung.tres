[ext_resource type="Script" path="res://sources/db/instance/QuestData.gd" id="1_qd"]

[resource]
script = ExtResource("1_qd")
name = "Thanh Trừ Linh Trùng"
description = "Linh khí quanh Trúc Sơn xuất hiện dị biến, Linh Trùng sinh sôi quấy nhiễu linh mạch sơn môn. Đạo Huyền Trưởng Lão giao phó đệ tử tiêu diệt 5 Linh Trùng dưới chân núi để ổn định linh mạch."
giver = "Đạo Huyền Trưởng Lão"
giverLocation = "Trúc Sơn Tiên Cảnh"
target = "Tiêu diệt 5 Linh Trùng"
targetLocation = "Trúc Sơn Tiên Cảnh (1100, 1350)"

reward = "50 Tu Vi, 100 Linh Thạch, Thanh Phong Kiếm"
