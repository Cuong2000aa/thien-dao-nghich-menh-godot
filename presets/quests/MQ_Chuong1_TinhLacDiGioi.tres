[resource]
script = ExtResource("1_qd")
name = "Tỉnh Lạc Dị Giới"
description = "Tỉnh dậy nơi sơn dã hoang vu sau biến cố xuyên không. Nhận diện thể trạng Ngũ Hành Tạp Căn và làm quen với hoàn cảnh mới bằng tư duy quan sát hiện đại."
giver = "Tiếp Dẫn Chấp Sự"
giverLocation = "Trúc Sơn Tiên Cảnh (1050, 1460)"
target = "Nói chuyện với Tiếp Dẫn Chấp Sự và kiểm tra Đan Điền"
targetLocation = "Trúc Sơn Tiên Cảnh (1050, 1460)"
reward = "100 Tu Vi, 50 Linh Thạch, Khăn Vải Thô"
