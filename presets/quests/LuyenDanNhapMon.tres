[resource]
script = ExtResource("1_qd")
name = "Luyện Đan Nhập Môn"
description = "Đạo Huyền Trưởng Lão hướng dẫn đệ tử đến Luyện Đan Lô tại Trúc Sơn, sử dụng 2 Linh Trùng Tương và 1 Ngân Linh Thảo để luyện thành 1 Hồi Xuân Dược."
giver = "Đạo Huyền Trưởng Lão"
