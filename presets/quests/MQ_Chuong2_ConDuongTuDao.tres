[resource]
script = ExtResource("1_qd")
name = "Con Đường Tu Đạo"
description = "Học tập quy tắc tu luyện cơ bản, thám sát chân núi Trúc Sơn và giải mã những dòng văn khắc bất thường đầu tiên trên Trúc Sơn Cổ Bi."
giver = "Đạo Huyền Trưởng Lão"
