target = "Khám phá Trúc Sơn Cổ Bi và ngộ nhập Tụ Khí cảnh"
targetLocation = "Trúc Sơn Cổ Bi"
reward = "150 Tu Vi, 100 Linh Thạch, 1 Hồi Xuân Đan"
