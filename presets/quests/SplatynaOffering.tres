[resource]
script = ExtResource("1_7vvcv")
id = 665326971
name = "Splatyna's Offering"
description = "Bicies đợi ở cửa hang, say mê đại slime tên Splatyna. Hắn bảo nàng thích vàng và giữ tà khí xa.
Muốn đến chỗ nàng, đạo hữu phải hạ ba thuộc hạ — mỗi kẻ giữ một chìa khóa.

Mang đủ ba chìa đến cuối hang, mở cổng và đối đầu Splatyna."
giver = "Bicies"
giverLocation = "Cửa Hang Splatyna"
target = "Splatyna"
targetLocation = "Điện Splatyna"
reward = "Chưa biết"
metadata/_custom_type_script = "uid://bqxdwogial88g"
