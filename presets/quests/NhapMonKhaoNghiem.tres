giverLocation = "Sơn Môn Trúc Sơn"
target = "Vượt qua khảo nghiệm & Bái kiến Trưởng lão"
targetLocation = "Trúc Sơn Tiên Cảnh"
reward = "Thân Phận Tạp Dịch, Tạp Dịch Lệnh Bài, 30 Tu Vi, 50 Linh Thạch"
