[resource]
script = ExtResource("1_qd")
name = "Khảo Nghiệm Nhập Môn"
description = "Đến gặp Tiếp Dẫn Chấp Sự tại cổng Sơn Môn, vượt qua bài khảo nghiệm tâm tính và căn cơ để bái nhập môn phái, nhận thân phận Tạp Dịch Đệ Tử."
