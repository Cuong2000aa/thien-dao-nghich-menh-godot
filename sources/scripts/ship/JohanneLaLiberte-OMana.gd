extends NpcScript

#
func OnStart():
	Narrate("Ô Linh Khí, ta lên thuyền vượt biển chỉ để tìm ngươi.")
	Narrate("Ô Linh Khí, làm sao ta thành anh hùng? Ngươi muốn gì ở ta trong thế giới u sầu này?")
	Narrate("Ô Linh Khí, có phải chìa khóa là vượt qua trận trận chiến để đạt tri thức, hay còn điều gì khác?")
	Narrate("Ô Linh Khí, xin lắng nghe ta, chỉ ta cách mạnh hơn và dẫn lối.")
	Narrate("Ô Linh Khí, ta chỉ muốn dừng chân nhìn quanh — gặp những người tốt đẹp quanh mình.")
	Narrate("Ô Linh Khí, có lẽ ta tìm được con đường trong thế giới này, cùng bằng hữu chiến đấu vai kề vai.")
	Narrate("Ô Linh Khí, từ thị trấn này sang thị trấn khác, ta gặp người ấy — người đi qua đời ta và thành tri kỷ, thành phu quân.")
	Narrate("Ô Linh Khí, ta cùng người ấy săn bắn, chia sẻ và băng qua rừng sâu.")
	Narrate("Ô Linh Khí, người ấy cho ta tự tin, nỗi sợ ta bớt đi.")
	Narrate("Ô Linh Khí, cùng nhau ta có thể giúp và bảo vệ người khác khỏi bóng tối.")
	Narrate("Ô Linh Khí, giờ ta có can đảm tiếp bước đến cùng.")
	Narrate("Ô Linh Khí, thật ra nhờ ngươi ta mới tìm được tình bạn — để cùng nhau sống ManaWorld!")
	Mes("Johanne Laliberté, 2011")
